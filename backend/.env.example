APP_NAME=AI Interview Backend
APP_ENV=local

# Persistent workflow. Compose uses PostgreSQL and local S3-compatible MinIO.
DATABASE_URL=postgresql+asyncpg://ai_interview:change-me@localhost:5432/ai_interview
DATABASE_ECHO=false
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=ai-interviews
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
APP_BASE_URL=http://localhost:3000
WORKFLOW_INVITE_BASE_URL=http://localhost:3000/?invite=
WORKFLOW_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_NAME=signal_session
SESSION_TTL_HOURS=168
INVITE_TTL_DAYS=14

# All workflow inference goes through OpenRouter. Keep the actual key only in
# the ignored .env file.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_STT_MODEL=openai/whisper-1
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_TTS_VOICE=Kore
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Signal AI Interview

# Legacy stateless question generation and answer evaluation. OPENAI_API_KEY is
# a legacy variable name and must contain an OpenRouter key. Both values are
# required; these compatibility endpoints use the configured proxy.
OPENAI_API_KEY=
OPENAI_PROXY_URL=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_RETRIES=1
QUESTION_GENERATION_MODEL=openai/gpt-5.6-luna
INTERVIEW_JUDGE_WORKERS=6

MAX_DOCUMENT_BYTES=10485760
MAX_DOCUMENT_CHARACTERS=100000
MAX_AUDIO_BYTES=20971520

WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_TIMEOUT_SECONDS=300
WHISPER_BEAM_SIZE=5

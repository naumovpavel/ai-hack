# Copy this file to .env and fill every value marked REQUIRED.
# Never commit .env. The API key previously shared in a chat should be rotated
# before it is used here.

COMPOSE_PROJECT_NAME=ai-interview
APP_ENV=local

# Published local ports (non-secret).
HOST_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
UI_PORT=3000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL.
POSTGRES_DB=ai_interview
POSTGRES_USER=ai_interview
# REQUIRED: local secret. Use a URL-safe value because Compose also places it
# into DATABASE_URL.
POSTGRES_PASSWORD=

# MinIO administrator and application credentials.
# REQUIRED: local secrets; passwords/secrets must be at least 8 characters.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ai-interviews
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000

# Browser/API integration.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000
WORKFLOW_INVITE_BASE_URL=http://localhost:3000/?invite=
WORKFLOW_COOKIE_SECURE=false

# OpenRouter. Keep the key only in .env; every model call leaves the local stack
# through this provider.
# REQUIRED for model-backed flows.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
OPENROUTER_STT_MODEL=openai/whisper-1
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_TTS_VOICE=Sulafat
OPENROUTER_TIMEOUT_SECONDS=120

# Optional compatibility endpoints: /questions/generate and
# /interviews/evaluate-answer. OPENAI_API_KEY is a legacy variable name and
# must contain an OpenRouter key; these endpoints also require an HTTPS proxy.
OPENAI_API_KEY=
OPENAI_PROXY_URL=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731
QUESTION_GENERATION_MODEL=openai/gpt-5.6-luna
INTERVIEW_JUDGE_WORKERS=6

# Telegram login and status notifications. Never commit the bot token.
TELEGRAM_BOT_TOKEN=
# Optional: resolved via getMe when blank.
TELEGRAM_BOT_USERNAME=
# Run exactly one backend worker in polling mode; webhook supports multiple workers.
TELEGRAM_UPDATE_MODE=polling
# Required only in webhook mode. Configure this same secret with Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=
# Test fixtures only; disabled whenever a Telegram token is configured or in production.
DEMO_AUTH_ENABLED=false
